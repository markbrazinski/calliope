# Calliope configuration. Copy to .env (never commit it). Values stay on the server; none reach the browser.

# --- Providers -----------------------------------------------------------------------------------------------
# YouCam (try-on pictures, colour analysis): https://yce.makeupar.com developer console
YOUCAM_API_KEY=
# AWS (Nova 2 Lite for photo reading and change requests; Amazon Transcribe for speech). Keys are NOT read from here:
# use a named profile in ~/.aws (default "calliope"). It needs bedrock:InvokeModel (Converse) on us.amazon.nova-2-lite-v1:0
# and, for voice input, transcribe:StartStreamTranscriptionWebSocket.
AWS_PROFILE=calliope
AWS_REGION=us-east-1

# --- Spending caps (each one is a hard stop; nothing is charged beyond it) --------------------------------------
# YouCam units this server may commit (one full journey with a change request is about 55-65 units: a change request
# pictures up to two options; 1 unit = about $0.055)
CALLIOPE_LIVE_UNITS=80
# Nova cap in USD for this server (about $0.003 per journey; catalog classification draws on it too)
CALLIOPE_NOVA_USD=0.05
# Amazon Transcribe cap in USD (metered at $0.024 per minute of speech, billed per second). Unset = voice input off.
CALLIOPE_TRANSCRIBE_USD=0.25

# --- Catalog (built from the Livostyle catalog MCP) ------------------------------------------------------------
# Days before the index is refreshed (checked at start and when a session starts; never on a timer)
CALLIOPE_CATALOG_REFRESH_DAYS=7
# Most a single catalog build may spend on paid classification (new or changed trousers, shoes, necklaces)
CALLIOPE_CATALOG_NOVA_USD=0.05
# 0 = ignore the shipped data/catalog.json and build the first index from the MCP (still reuses shipped classifications)
# CALLIOPE_CATALOG_SNAPSHOT=1

# --- Optional ---------------------------------------------------------------------------------------------------
# PORT=8765
# CALLIOPE_HOST=127.0.0.1          # 0.0.0.0 to reach it from a phone on the same network (use HTTPS, below)
# CALLIOPE_TLS_CERT=               # HTTPS: a phone's microphone only works on a secure page (e.g. mkcert for your LAN IP)
# CALLIOPE_TLS_KEY=
# CALLIOPE_BASIC_AUTH=user:password   # protect the app when it is reachable beyond this computer
# CALLIOPE_SPEECH_LANGUAGE=en-US
